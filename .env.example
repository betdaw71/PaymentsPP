# Copy to .env on server: cp .env.example .env && nano .env
# NEVER commit .env to git

ACME_EMAIL=admin@example.com

POSTGRES_DB=titanpay_db
POSTGRES_USER=titanpay_user
POSTGRES_PASSWORD=change-me
CRYPTO_DB_NAME=cryptodb

MAIN_DB_NAME=titanpay_db
MAIN_DB_USER=titanpay_user
MAIN_DB_PASSWORD=change-me
MAIN_DB_HOST=db
MAIN_DB_PORT=5432

# Sync gunicorn workers in titanpay_app (entrypoint.sh). 2 vCPU: start with 4, not 8.
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

DEBUG=False
SECRET_KEY=change-me-long-random-string
LOCAL=False
DJANGO_SETTINGS_MODULE=titanpay.settings

REDIS_HOST=redis:6379/1

VITE_API_URL=https://api.avapay.net/api/v1

CRYPTO_URL=http://crypto:8082
API_BOT_KEY=
PUBLIC_API_URL=https://api.example.com
# Apex domain; hosted checkout is https://pay.{PAYMENT_PAGE_URL}/{id}
PAYMENT_PAGE_URL=avapay812.cc
# Melbet-only checkout clone. 0 = instant rollback to generic pay.html (restart app, no rebuild)
MELBET_PAYMENT_PAGE=1
# Nearby-amount uniqualization (±20/50/100). Off until routing is stable.
MELBET_AMOUNT_PROBE_ENABLED=false
# true = reject a new pay-in if the client already has one In Progress
ENFORCE_PENDING_PAYIN=false

# --- Yandex Object Storage (S3-compatible) ---
# Console: cloud.yandex.ru → Object Storage → bucket → Service account → Static access key
S3_ENDPOINT=https://storage.yandexcloud.net
ACCESS_KEY=YCAJxxxxxxxxxxxxxxxx
SECRET_S3_KEY=YCPxxxxxxxxxxxxxxxx
BUCKET_NAME=paymentspp

# autosms uses the same bucket (can share keys)
AUTOSMS_BUCKET_NAME=paymentspp
AUTOSMS_S3_ENDPOINT=https://storage.yandexcloud.net
AUTOSMS_ACCESS_KEY=YCAJxxxxxxxxxxxxxxxx
AUTOSMS_SECRET_KEY=YCPxxxxxxxxxxxxxxxx

# Cascade: smaller number = earlier. payplat offline → 99; plutus off → 98; astrum_kzt (asterisk) ~30% share.
PSP_ROUTING_PRIORITY_MAP={"patriot1":1,"gipay1":2,"prochub1":3,"visionx1":4,"bitzone1":5,"astrum_kzt":6,"layerone1":10,"nexus1":11,"plutus1":98,"payplat1":99}
# Per-merchant cascade (overrides global priority + disables SHARE_MAP for that merchant).
PSP_ROUTING_PRIORITY_BY_MERCHANT={"pandapay":{"patriot1":1,"gipay1":2,"prochub1":3,"layerone1":4,"astrum_kzt":5,"plutus1":98,"payplat1":99}}
# Traffic share % of NEW orders (weighted random first slot). Empty {} = cascade only.
# Keys must be trader usernames (gipay1, not gipay). Short names are aliased in code as a fallback.
# astrum_kzt ≈30%; plutus1 omitted while disabled.
PSP_ROUTING_SHARE_MAP={"patriot1":25,"gipay1":20,"prochub1":15,"visionx1":10,"astrum_kzt":30}
PSP_ROUTING_SHARE_WINDOW_HOURS=24

# KZT трансгран: банки-PS. Мерч шлёт C2C/C2CKZT, реквизит bank=имя PS.
KZT_C2C_BANK_PS_NAMES=Vietcombank,Vietinbank
# XE USD/KZT: глобально +5%, Vietcombank +4%
XE_KZT_MARKUP_BY_PS={"Vietcombank":"1.04"}
# Per-merchant FX markup (pandapay xe+4 while C2CKZT stays xe+5 for others)
XE_KZT_MARKUP_BY_MERCHANT={"pandapay":"1.04"}
# KZT dual FX: PSP xe+N vs merchant xe+5. plutus/astrum = xe+3. Bitzone — Binance P2P Kaspi.
PSP_XE_MARKUP_BY_TRADER={"payplat1":"1.05","patriot1":"1.03","gipay1":"1.04","visionx1":"1.03","layerone1":"1.02","prochub1":"1.02","nexus1":"1.04","plutus1":"1.03","astrum_kzt":"1.03"}
BITZONE_BINANCE_PAY_TYPE=KaspiBank

PROTOCOL_API_BASE=https://prot0col.com
PROTOCOL_API_KEY=
PROTOCOL_MERCHANT_ID=
PROTOCOL_SECRET_KEY=
PROTOCOL_TRADER_USERNAME=protocol1

# Layer-1 (layer-1.io) — KZT method c2ckz. Secrets only in server .env.
LAYERONE_API_BASE=https://layer-1.io
LAYERONE_MERCHANT_ID=
LAYERONE_SECRET_KEY=
LAYERONE_API_KEY=
LAYERONE_TRADER_USERNAME=layerone1
LAYERONE_PAYIN_METHOD=c2ckz
LAYERONE_PAYIN_METHOD_MAP={"C2CKZT":"c2ckz","C2C":"c2ckz"}

# PatriotPay (api.patriotpay.club) — KZT H2H Scenario A. Secrets only in server .env.
# PATRIOTPAY_API_KEY = X-Identity from merchant LK; PATRIOTPAY_SECRET_KEY = secret from LK settings.
# Docs site basic-auth password is NOT the merchant API key.
PATRIOTPAY_API_BASE=https://api.patriotpay.club
PATRIOTPAY_API_KEY=
PATRIOTPAY_SECRET_KEY=
PATRIOTPAY_TRADER_USERNAME=patriot1
PATRIOTPAY_PAYIN_OPTION=CROSS_BORDER
PATRIOTPAY_PAYIN_OPTION_MAP={"C2CKZT":"CROSS_BORDER","C2C":"CROSS_BORDER"}
PATRIOTPAY_PAYIN_METHOD_MAP={"C2CKZT":"","C2C":""}
PATRIOTPAY_CROSS_BORDER_REQUISITE_TYPE=CARD

PLAYMENTS_API_BASE=https://api.playments.world
PLAYMENTS_MERCHANT_GROUP_ID=
PLAYMENTS_MERCHANT_ID=
PLAYMENTS_SECRET_KEY=
PLAYMENTS_WEBHOOK_SECRET=
PLAYMENTS_DEFAULT_CLIENT_IP=127.0.0.1

# Astrum KZT pay-out (Fernet + Authorization API key). Docs: https://astrum.ac/api/redoc
# Whitelist production egress IP at Astrum; callback: {PUBLIC_API_URL}/api/v1/webhooks/psp/astrum/payout/
ASTRUM_API_BASE=https://astrum.ac/api
ASTRUM_API_KEY=
ASTRUM_PRIVATE_KEY=
ASTRUM_TRADER_USERNAME=astrum_kzt
ASTRUM_C2C_NAME=C2CKZT
ASTRUM_CURRENCY=KZT
ASTRUM_METHOD_TYPE_ID=
ASTRUM_METHOD_NAME_ID=
ASTRUM_EXPRESS=false
# payout callback (default: {PUBLIC_API_URL}/api/v1/webhooks/psp/astrum/payout/)
ASTRUM_CALLBACK_URL=
# payin callback (default: {PUBLIC_API_URL}/api/v1/webhooks/psp/astrum/payin/)
ASTRUM_PAYIN_CALLBACK_URL=
# JSON: merchant username → preferred pay-out trader (Mostbet C2CKZT → PayPlat)
PAYOUT_PREFERRED_TRADER_BY_MERCHANT={"mostbet":"payplat1","lunatrixpay":"payplat1"}
# Mostbet sends payouts as C2C; platform remaps KZT C2C → C2CKZT
PAYOUT_C2C_TO_C2CKZT_MERCHANTS=mostbet,lunatrixpay

# Bybit P2P red book USDT/KZT (Kaspi, 50 000, verified, rows 15–16) — only PayPlat payouts
BYBIT_KZT_AMOUNT=50000
BYBIT_KZT_AUTH_MAKER=true
BYBIT_KZT_ROWS=15,16
PAYOUTKZT_PS_NAME=PAYOUTKZT
# Optional token for GET /api/v1/payments/rate/payoutkzt/ (X-Rate-Token or Bearer). Empty = public.
RATE_API_TOKEN=

# PayPlat payouts (POST {PAYPLAT_API_BASE}/payout). currency=KZT only with payout_type=kzt.
PAYPLAT_PAYOUT_PATH=/payout
PAYPLAT_PAYOUT_REQUISITE_TYPE=card
PAYPLAT_PAYOUT_TYPE=kzt
PAYPLAT_PAYOUT_CURRENCY=KZT
PAYPLAT_PAYOUT_NAME=IVAN
PAYPLAT_PAYOUT_SURNAME=PETROV
PAYPLAT_PAYOUT_BANK=kaspi
PAYPLAT_PAYOUT_AMOUNT_MODE=usd

# Concored / ProcessorCore (MMK). API host — уточните у Concored (НЕ https://concored.com — это SPA).
CONCORDED_API_BASE=
CONCORDED_TRADER_USERNAME=concored_mmk
# Bearer JWT по MID (MID-0000011 / MID-0000012)
CONCORDED_KBZPAY_TOKEN=
CONCORDED_WAVEPAY_TOKEN=
# Код paymentMethod из личного кабинета Concored, НЕ JWT. Пример: P2P_PAYIN_..._MMK_...
CONCORDED_PAYMENT_METHOD_MAP={"KBZPay":"","WavePay":""}
CONCORDED_AMOUNT_MINOR_FACTOR=1

# PlutusPay (plutuspay.top). Callback: {PUBLIC_API_URL}/api/v1/webhooks/psp/plutus/
PLUTUS_API_BASE=https://plutuspay.top
PLUTUS_API_KEY=
PLUTUS_TRADER_USERNAME=plutus1
PLUTUS_DEFAULT_PAYMETHOD=c2c
PLUTUS_PAYMETHOD_MAP={"C2C":"c2c","C2CKZT":"c2c"}

# Nexus / Spyder (https://az26juuc.xyz). Callback: {PUBLIC_API_URL}/api/v1/webhooks/psp/nexus/
NEXUS_API_BASE=https://az26juuc.xyz
NEXUS_API_TOKEN=
NEXUS_CALLBACK_SECRET=
NEXUS_TRADER_USERNAME=nexus1
NEXUS_PAYMENT_METHOD=card
NEXUS_TIMEOUT_SECONDS=900

TGBOT_TOKEN=
EMERGENCY_TELEBOT_TOKEN=
ORDERBOT_TELEBOT_TOKEN=
AUTOSMSBOT_TELEBOT_TOKEN=
APPEAL_TELEBOT_TOKEN=
APPEAL_BOT_API_TOKEN=

# Админ-алерты: баланс Panda/Aggrepay/Melbet/Mostbet + payout + вывод мерчанта
ADMIN_ALERT_BOT_TOKEN=
ADMIN_ALERT_CHAT_ID=
ADMIN_ALERT_PANDAPAY_MAX=2800
ADMIN_ALERT_AGGREPAY_MAX=4000
ADMIN_ALERT_MELBET_KZT_MAX=-1500000
ADMIN_ALERT_MOSTBET_MIN=1000
# PayPlat: алерт если ≥N отказов выдачи за WINDOW секунд (cooldown между алертами)
ADMIN_ALERT_PAYPLAT_FAIL_BURST=5
ADMIN_ALERT_PAYPLAT_FAIL_WINDOW_SEC=300
ADMIN_ALERT_PAYPLAT_COOLDOWN_SEC=600
# Конверсия: iss→ok ниже порога за WINDOW минут при ≥MIN create
ADMIN_ALERT_CONV_WINDOW_MIN=15
ADMIN_ALERT_CONV_MIN_CREATED=20
ADMIN_ALERT_CONV_ISSUED_PCT_MIN=15
ADMIN_ALERT_CONV_MERCHANTS=melbet,mostbet
ADMIN_ALERT_CONV_COOLDOWN_SEC=900

# Appeal userbot (Telegram user account, not BotFather). See appealbot/USERBOT.txt
# docker compose --profile userbot up -d --build appeal-userbot
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
USERBOT_WATCH_CHAT_IDS=
USERBOT_SOURCE_USERNAMES=
USERBOT_CLICK_INLINE=0

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Касса: USDT TRC-20 кошелёк площадки
CASH_REGISTER_TRC20_WALLET=TEPKpVsAUyrkLx38ueFzSQP1HXGX8XK1Tt
TRONGRID_API_KEY=
CASH_REGISTER_PREPAID_TO_PSP=gipay1,visionx1,bitzone1,patriot1,layerone1
CASH_REGISTER_DEPOSIT_FROM_PSP=payplat1,prochub1
CASH_REGISTER_LIABILITY_MERCHANTS=alemkredit,pandapay,aggrepay
CASH_REGISTER_ROLLING_MERCHANTS=mostbet
