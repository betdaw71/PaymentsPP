# Copy to .env on server: cp .env.example .env && nano .env
# NEVER commit .env to git

ACME_EMAIL=admin@example.com

POSTGRES_DB=titanpay_db
POSTGRES_USER=titanpay_user
POSTGRES_PASSWORD=change-me
CRYPTO_DB_NAME=cryptodb

MAIN_DB_NAME=titanpay_db
MAIN_DB_USER=titanpay_user
MAIN_DB_PASSWORD=change-me
MAIN_DB_HOST=db
MAIN_DB_PORT=5432

DEBUG=False
SECRET_KEY=change-me-long-random-string
LOCAL=False
DJANGO_SETTINGS_MODULE=titanpay.settings

REDIS_HOST=redis:6379/1

VITE_API_URL=https://api.example.com/api/v1

CRYPTO_URL=http://crypto:8082
API_BOT_KEY=
PUBLIC_API_URL=https://api.example.com
PAYMENT_PAGE_URL=example.com

# --- Yandex Object Storage (S3-compatible) ---
# Console: cloud.yandex.ru → Object Storage → bucket → Service account → Static access key
S3_ENDPOINT=https://storage.yandexcloud.net
ACCESS_KEY=YCAJxxxxxxxxxxxxxxxx
SECRET_S3_KEY=YCPxxxxxxxxxxxxxxxx
BUCKET_NAME=paymentspp

# autosms uses the same bucket (can share keys)
AUTOSMS_BUCKET_NAME=paymentspp
AUTOSMS_S3_ENDPOINT=https://storage.yandexcloud.net
AUTOSMS_ACCESS_KEY=YCAJxxxxxxxxxxxxxxxx
AUTOSMS_SECRET_KEY=YCPxxxxxxxxxxxxxxxx

PROTOCOL_API_BASE=https://prot0col.com
PROTOCOL_API_KEY=
PROTOCOL_MERCHANT_ID=
PROTOCOL_SECRET_KEY=
PROTOCOL_TRADER_USERNAME=protocol1

PLAYMENTS_API_BASE=https://api.playments.world
PLAYMENTS_MERCHANT_GROUP_ID=
PLAYMENTS_MERCHANT_ID=
PLAYMENTS_SECRET_KEY=
PLAYMENTS_WEBHOOK_SECRET=
PLAYMENTS_DEFAULT_CLIENT_IP=127.0.0.1

TGBOT_TOKEN=
EMERGENCY_TELEBOT_TOKEN=
ORDERBOT_TELEBOT_TOKEN=
AUTOSMSBOT_TELEBOT_TOKEN=

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
