# Copy to .env on server: cp .env.example .env && nano .env
# NEVER commit .env to git

ACME_EMAIL=admin@example.com

POSTGRES_DB=titanpay_db
POSTGRES_USER=titanpay_user
POSTGRES_PASSWORD=change-me
CRYPTO_DB_NAME=cryptodb

MAIN_DB_NAME=titanpay_db
MAIN_DB_USER=titanpay_user
MAIN_DB_PASSWORD=change-me
MAIN_DB_HOST=db
MAIN_DB_PORT=5432

DEBUG=False
SECRET_KEY=change-me-long-random-string
LOCAL=False
DJANGO_SETTINGS_MODULE=titanpay.settings

REDIS_HOST=redis:6379/1

VITE_API_URL=https://api.example.com/api/v1

CRYPTO_URL=http://crypto:8082
API_BOT_KEY=
PUBLIC_API_URL=https://api.example.com
# Apex domain; hosted checkout is https://pay.{PAYMENT_PAGE_URL}/{id}
PAYMENT_PAGE_URL=avapay812.cc
# true = reject a new pay-in if the client already has one In Progress
ENFORCE_PENDING_PAYIN=false

# --- Yandex Object Storage (S3-compatible) ---
# Console: cloud.yandex.ru → Object Storage → bucket → Service account → Static access key
S3_ENDPOINT=https://storage.yandexcloud.net
ACCESS_KEY=YCAJxxxxxxxxxxxxxxxx
SECRET_S3_KEY=YCPxxxxxxxxxxxxxxxx
BUCKET_NAME=paymentspp

# autosms uses the same bucket (can share keys)
AUTOSMS_BUCKET_NAME=paymentspp
AUTOSMS_S3_ENDPOINT=https://storage.yandexcloud.net
AUTOSMS_ACCESS_KEY=YCAJxxxxxxxxxxxxxxxx
AUTOSMS_SECRET_KEY=YCPxxxxxxxxxxxxxxxx

# Cascade: smaller number = earlier. bitzone1 defaults to 3 even if omitted.
PSP_ROUTING_PRIORITY_MAP={"payplat1": 1, "gipay1": 2, "bitzone1": 3}
# Traffic share % of NEW orders (weighted random first slot). Empty {} = cascade only.
# Example 70/30: ~70% of first attempts go to payplat1, ~30% to gipay1.
# Not a catch-up on 24h history (that sent everything to the smaller PSP).
PSP_ROUTING_SHARE_MAP={}
PSP_ROUTING_SHARE_WINDOW_HOURS=24

PROTOCOL_API_BASE=https://prot0col.com
PROTOCOL_API_KEY=
PROTOCOL_MERCHANT_ID=
PROTOCOL_SECRET_KEY=
PROTOCOL_TRADER_USERNAME=protocol1

PLAYMENTS_API_BASE=https://api.playments.world
PLAYMENTS_MERCHANT_GROUP_ID=
PLAYMENTS_MERCHANT_ID=
PLAYMENTS_SECRET_KEY=
PLAYMENTS_WEBHOOK_SECRET=
PLAYMENTS_DEFAULT_CLIENT_IP=127.0.0.1

# Concored / ProcessorCore (MMK). API host — уточните у Concored (НЕ https://concored.com — это SPA).
CONCORDED_API_BASE=
CONCORDED_TRADER_USERNAME=concored_mmk
# Bearer JWT по MID (MID-0000011 / MID-0000012)
CONCORDED_KBZPAY_TOKEN=
CONCORDED_WAVEPAY_TOKEN=
# Код paymentMethod из личного кабинета Concored, НЕ JWT. Пример: P2P_PAYIN_..._MMK_...
CONCORDED_PAYMENT_METHOD_MAP={"KBZPay":"","WavePay":""}
CONCORDED_AMOUNT_MINOR_FACTOR=1

TGBOT_TOKEN=
EMERGENCY_TELEBOT_TOKEN=
ORDERBOT_TELEBOT_TOKEN=
AUTOSMSBOT_TELEBOT_TOKEN=
APPEAL_TELEBOT_TOKEN=
APPEAL_BOT_API_TOKEN=

# Appeal userbot (Telegram user account, not BotFather). See appealbot/USERBOT.txt
# docker compose --profile userbot up -d --build appeal-userbot
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
USERBOT_WATCH_CHAT_IDS=
USERBOT_SOURCE_USERNAMES=
USERBOT_CLICK_INLINE=0

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
