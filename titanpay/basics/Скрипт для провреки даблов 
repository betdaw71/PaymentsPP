                time_distribution[hour] += 1
    
    if time_distribution:
        print("Распределение дубликатов по часам:")
        for hour in sorted(time_distribution.keys()):
            count = time_distribution[hour]
            print(f"  {hour:02d}:00 - {hour:02d}:59: {count} дубликатов")
    
    return all_results


def analyze_specific_date(date_str, threshold_minutes=5):
    """
    Анализирует дубликаты за конкретную дату
    
    Args:
        date_str: Дата в формате 'YYYY-MM-DD'
        threshold_minutes: Порог времени между дубликатами
    """
    try:
        # Парсим дату
        date_obj = datetime.strptime(date_str, '%Y-%m-%d').date()
        
        # Конвертируем в aware datetime
        date_start = timezone.make_aware(datetime.combine(date_obj, datetime.min.time()))
        date_end = date_start + timedelta(days=1)
        
        print("=" * 80)
        print(f"АНАЛИЗ ДУБЛИКАТОВ ЗА {date_str}")
        print("=" * 80)
        
        results = analyze_duplicates_for_date(date_start, date_end, threshold_minutes)
        
        # Предлагаем коррекцию
        if results['duplicates_found'] > 0:
            print(f"\n{'='*80}")
            print(f"ОБНАРУЖЕНО {results['duplicates_found']} ДУБЛИКАТОВ НА СУММУ {results['total_damage']} USDT")
            
            response = input(f"\nВыполнить коррекцию? (yes/no): ").strip()
            if response.lower() == 'yes':
                # Корректируем все найденные дубликаты
                correct_duplicates_for_results(results)
        
        return results
        
    except ValueError:
        print(f"❌ Неверный формат даты. Используйте формат 'YYYY-MM-DD'")
        return None


def correct_duplicates_for_results(results):
    """
    Корректирует дубликаты на основе результатов анализа
    """
    if not results or not results['duplicate_details']:
        print("Нет дубликатов для коррекции.")
        return
    
    print(f"\nНачинаем коррекцию {len(results['duplicate_details'])} дубликатов...")
    print("-" * 60)
    
    successful = 0
    failed = 0
    
    for i, dup in enumerate(results['duplicate_details'], 1):
        order = dup['order']
        order_type = "Входящий" if dup['type'] == 'in' else "Исходящий"
        order_id_str = str(order.id)[:8] + "..."
        
        print(f"\n[{i}/{len(results['duplicate_details'])}] Коррекция {order_type.lower()} ордера {order_id_str}")
        print(f"   Мерчант: {order.solution.merchant.user.username}")
        print(f"   Трейдер: {order.payment_details.group.trader.user.username}")
        print(f"   Сумма: {order.usd_amount} USDT")
        
        # Создаем описание
        description = f"Коррекционное списание по дублированному {'пополнению' if dup['type'] == 'in' else 'списанию'} по ордеру {order.id}"
        
        try:
            with transaction.atomic():
                if dup['type'] == 'in':
                    from_balance = order.solution.merchant.balance
                    to_balance = order.payment_details.group.trader.balance_usdt
                else:
                    from_balance = order.payment_details.group.trader.balance_usdt
                    to_balance = order.solution.merchant.balance
                
                amount = order.usd_amount
                
                # Получаем объекты балансов
                from_balance_obj = Balance.objects.get(id=from_balance.id)
                to_balance_obj = Balance.objects.get(id=to_balance.id)
                
                # Проверяем баланс
                if from_balance_obj.amount < amount:
                    print(f"   ⚠️  Внимание: Недостаточно средств! Доступно: {from_balance_obj.amount}, Требуется: {amount}")
                
                # Обновляем балансы
                from_balance_obj.amount -= amount
                to_balance_obj.amount += amount
                
                from_balance_obj.save()
                to_balance_obj.save()
                
                # Создаем транзакцию
                tx_type = TransactionType.objects.get(name="Charge")
                
                if dup['type'] == 'in':
                    tx = Transaction.objects.create(
                        from_balance=from_balance_obj,
                        to_balance=to_balance_obj,
                        transaction_type=tx_type,
                        linked_in_order=order,
                        comment=description,
                        value=amount
                    )
                else:
                    tx = Transaction.objects.create(
                        from_balance=from_balance_obj,
                        to_balance=to_balance_obj,
                        transaction_type=tx_type,
                        linked_out_order=order,
                        comment=description,
                        value=amount
                    )
                
                successful += 1
                print(f"   ✅ Успешно! Транзакция: {tx.id}")
                
        except Exception as e:
            failed += 1
            print(f"   ❌ Ошибка: {str(e)}")
    
    print(f"\n{'='*60}")
    print(f"ИТОГ КОРРЕКЦИИ:")
    print(f"  Успешно: {successful}")
    print(f"  С ошибками: {failed}")
    print(f"{'='*60}")


def export_daily_report(results, filename="daily_duplicates_report.txt"):
    """
    Экспортирует ежедневный отчет в файл
    """
    with open(filename, 'w', encoding='utf-8') as f:
        f.write("=" * 80 + "\n")
        f.write("ЕЖЕДНЕВНЫЙ ОТЧЕТ ПО ДУБЛИКАТАМ\n")
        f.write("=" * 80 + "\n\n")
        
        f.write(f"Дата отчета: {timezone.now().strftime('%Y-%m-%d %H:%M:%S')}\n\n")
        
        for day_key, day_name in [
            ('day_before_yesterday', 'Позавчера'),
            ('yesterday', 'Вчера'),
            ('today', 'Сегодня')
        ]:
            if results[day_key]:
                day_results = results[day_key]
                
                # Определяем дату дня
                if day_key == 'today':
                    date_str = timezone.now().strftime('%Y-%m-%d') + " (частично)"
                elif day_key == 'yesterday':
                    date_str = (timezone.now() - timedelta(days=1)).strftime('%Y-%m-%d')
                else:  # day_before_yesterday
                    date_str = (timezone.now() - timedelta(days=2)).strftime('%Y-%m-%d')
                
                f.write(f"{day_name.upper()} ({date_str}):\n")
                f.write("-" * 40 + "\n")
                f.write(f"Всего заявок: {day_results['total_analyzed']}\n")
                f.write(f"Дубликатов: {day_results['duplicates_found']}\n")
                f.write(f"  - Входящих: {day_results['in_duplicates']}\n")
                f.write(f"  - Исходящих: {day_results['out_duplicates']}\n")
                f.write(f"Ущерб: {day_results['total_damage']} USDT\n")
                
                if day_results['damage_summary']:
                    f.write("\nДетали ущерба:\n")
                    for (merchant, trader), data in day_results['damage_summary'].items():
                        f.write(f"  {merchant} -> {trader}:\n")
                        f.write(f"    Сумма: {data['amount']} USDT\n")
                        f.write(f"    Количество: {data['count']}\n")
                
                f.write("\n")
        
        # Сводка
        f.write("=" * 40 + "\n")
        f.write("СВОДНАЯ СТАТИСТИКА ЗА 3 ДНЯ\n")
        f.write("=" * 40 + "\n")
        f.write(f"Всего дубликатов: {results['total']['duplicates_found']}\n")
        f.write(f"Общий ущерб: {results['total']['total_damage']} USDT\n\n")
        
        f.write("По дням:\n")
        for date_str, data in results['total']['damage_by_day'].items():
            f.write(f"  {date_str}: {data['duplicates']} дубликатов, {data['damage']} USDT\n")
    
    print(f"\n📄 Отчет экспортирован в файл: {filename}")


