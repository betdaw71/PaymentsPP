def analyze_duplicates_for_date(date_start, date_end, threshold_minutes=5):
    """
    Анализирует дубликаты за указанный период
    
    Args:
        date_start: Начало периода
        date_end: Конец периода
        threshold_minutes: Максимальное время между дубликатами
    """
    print(f"\n📅 Анализ периода: {date_start.strftime('%Y-%m-%d %H:%M')} - {date_end.strftime('%Y-%m-%d %H:%M')}")
    print("-" * 60)
    
    results = {
        'total_analyzed': 0,
        'duplicates_found': 0,
        'in_duplicates': 0,
        'out_duplicates': 0,
        'damage_summary': defaultdict(lambda: {'amount': Decimal('0'), 'count': 0}),
        'total_damage': Decimal('0'),
        'duplicate_details': []
    }
    
    # 1. Анализ входящих заявок
    print("1. ВХОДЯЩИЕ ЗАЯВКИ (InOrder):")
    
    completed_in_orders = InOrder.objects.filter(
        status__name="Completed",
        completion_date__gte=date_start,
        completion_date__lt=date_end
    ).select_related(
        'solution__merchant__user',
        'payment_details__group__trader__user'
    ).order_by('creation_date')
    
    results['total_analyzed'] += completed_in_orders.count()
    print(f"   Всего заявок: {completed_in_orders.count()}")
    
    # Группируем по ключу для поиска дубликатов
    in_order_groups = defaultdict(list)
    
    for order in completed_in_orders:
        if order.solution and order.solution.merchant and order.payment_details and order.payment_details.group:
            key = (
                order.solution.merchant.id,
                order.payment_details.group.trader.id,
                round(order.usd_amount, 2),
                order.creation_date.strftime('%Y-%m-%d %H')
            )
            in_order_groups[key].append(order)
    
    # Находим дубликаты
    for key, orders in in_order_groups.items():
        if len(orders) > 1:
            orders.sort(key=lambda x: x.creation_date)
            
            for i in range(len(orders)):
                for j in range(i + 1, len(orders)):
                    time_diff = abs((orders[i].creation_date - orders[j].creation_date).total_seconds())
                    if time_diff < threshold_minutes * 60:
                        results['duplicates_found'] += 1
                        results['in_duplicates'] += 1
                        
                        merchant = orders[j].solution.merchant.user.username
                        trader = orders[j].payment_details.group.trader.user.username
                        amount = orders[j].usd_amount
                        
                        results['damage_summary'][(merchant, trader)]['amount'] += amount
                        results['damage_summary'][(merchant, trader)]['count'] += 1
                        results['total_damage'] += amount
                        
                        results['duplicate_details'].append({
                            'order': orders[j],
                            'primary': orders[i],
                            'time_diff': time_diff,
                            'type': 'in'
                        })
                        break
    
    print(f"   Найдено дубликатов: {results['in_duplicates']}")
    
    # 2. Анализ исходящих заявок
    print("\n2. ИСХОДЯЩИЕ ЗАЯВКИ (OutOrder):")
    
    completed_out_orders = OutOrder.objects.filter(
        status__name="Completed",
        completion_date__gte=date_start,
        completion_date__lt=date_end
    ).select_related(
        'solution__merchant__user',
        'payment_details__group__trader__user'
    ).order_by('creation_date')
    
    results['total_analyzed'] += completed_out_orders.count()
    print(f"   Всего заявок: {completed_out_orders.count()}")
    
    # Группируем по ключу для поиска дубликатов
    out_order_groups = defaultdict(list)
    
    for order in completed_out_orders:
        if order.solution and order.solution.merchant and order.payment_details and order.payment_details.group:
            key = (
                order.solution.merchant.id,
                order.payment_details.group.trader.id,
                round(order.usd_amount, 2),
                order.creation_date.strftime('%Y-%m-%d %H')
            )
            out_order_groups[key].append(order)
    
    # Находим дубликаты
    for key, orders in out_order_groups.items():
        if len(orders) > 1:
            orders.sort(key=lambda x: x.creation_date)
            
            for i in range(len(orders)):
                for j in range(i + 1, len(orders)):
                    time_diff = abs((orders[i].creation_date - orders[j].creation_date).total_seconds())
                    if time_diff < threshold_minutes * 60:
                        results['duplicates_found'] += 1
                        results['out_duplicates'] += 1
                        
                        merchant = orders[j].solution.merchant.user.username
                        trader = orders[j].payment_details.group.trader.user.username
                        amount = orders[j].usd_amount
                        
                        results['damage_summary'][(merchant, trader)]['amount'] += amount
                        results['damage_summary'][(merchant, trader)]['count'] += 1
                        results['total_damage'] += amount
                        
                        results['duplicate_details'].append({
                            'order': orders[j],
                            'primary': orders[i],
                            'time_diff': time_diff,
                            'type': 'out'
                        })
                        break
    
    print(f"   Найдено дубликатов: {results['out_duplicates']}")
    
    # 3. Выводим итог по периоду
    print(f"\n3. ИТОГ ЗА ПЕРИОД:")
    print(f"   Всего проанализировано заявок: {results['total_analyzed']}")
    print(f"   Всего найдено дубликатов: {results['duplicates_found']}")
    print(f"   Общий ущерб: {results['total_damage']} USDT")
    
    if results['damage_summary']:
        print(f"\n4. ДЕТАЛИ УЩЕРБА:")
        for (merchant, trader), data in results['damage_summary'].items():
            print(f"   {merchant} -> {trader}:")
            print(f"     Сумма: {data['amount']} USDT")
            print(f"     Количество дубликатов: {data['count']}")
    
    # Выводим примеры дубликатов
    if results['duplicate_details']:
        print(f"\n5. ПРИМЕРЫ ДУБЛИКАТОВ (первые 3):")
        for i, dup in enumerate(results['duplicate_details'][:3], 1):
            order = dup['order']
            order_type = "Входящий" if dup['type'] == 'in' else "Исходящий"
            order_id_str = str(order.id)[:8] + "..."
            
            print(f"   {i}. {order_type} ордер {order_id_str}")
            print(f"      Мерчант: {order.solution.merchant.user.username}")
            print(f"      Трейдер: {order.payment_details.group.trader.user.username}")
            print(f"      Сумма: {order.usd_amount} USDT")
            print(f"      Дата: {order.creation_date.strftime('%Y-%m-%d %H:%M:%S')}")
            print(f"      Разница во времени: {dup['time_diff']:.0f} сек")
    
    print("\n" + "-" * 60)
    
    return results


def analyze_yesterday_today():
    """
    Анализирует дубликаты за вчерашний и позавчерашний день
    """
    now = timezone.now()
    
    # Сегодняшний день (от начала до текущего момента)
    today_start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    today_end = now
    
    # Вчерашний день (полные сутки)
    yesterday_start = today_start - timedelta(days=1)
    yesterday_end = today_start
    
    # Позавчерашний день
    day_before_yesterday_start = yesterday_start - timedelta(days=1)
    day_before_yesterday_end = yesterday_start
    
