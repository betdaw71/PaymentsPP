    if combined_damage:
        # Сортируем по ущербу (по убыванию)
        sorted_damage = sorted(combined_damage.items(), key=lambda x: x[1]['amount'], reverse=True)
        
        print("ТОП-10 связок по ущербу:")
        for i, (key, data) in enumerate(sorted_damage[:10], 1):
