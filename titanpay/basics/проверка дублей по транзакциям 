def fix_transaction_duplicates(duplicate_groups):
    """
    Исправление найденных дубликатов транзакций
    """
    from django.db import transaction as db_transaction
    
    print("=" * 80)
    print("🛠️  ИСПРАВЛЕНИЕ ДУБЛИКАТОВ ТРАНЗАКЦИЙ")
    print("=" * 80)
    
    total_fixed = 0
    total_errors = 0
    
    for group_num, group in enumerate(duplicate_groups, 1):
        if len(group) <= 1:
            continue
        
        print(f"\nГруппа {group_num} ({len(group)} транзакций):")
        
        # Оставляем первую транзакцию, остальные помечаем как дубликаты
        keep_tx = group[0]
        duplicate_txs = group[1:]
        
        print(f"  Оставляем транзакцию: {keep_tx.id}")
        print(f"  Помечаем как дубликаты: {len(duplicate_txs)} транзакций")
        
        try:
            with db_transaction.atomic():
                for dup_tx in duplicate_txs:
                    # Обновляем комментарий
                    new_comment = f"[ДУБЛИКАТ {keep_tx.id}] {dup_tx.comment}"
                    dup_tx.comment = new_comment
                    dup_tx.save()
                    
                    print(f"    • Транзакция {dup_tx.id} помечена как дубликат")
                
                total_fixed += len(duplicate_txs)
                
        except Exception as e:
            total_errors += 1
            print(f"    ❌ Ошибка при обработке группы: {str(e)}")
    
    print(f"\n{'='*40}")
    print(f"ИТОГ ИСПРАВЛЕНИЙ:")
    print(f"  Помечено как дубликаты: {total_fixed} транзакций")
    print(f"  Ошибок: {total_errors}")
    print(f"{'='*40}")


def find_transaction_by_comment(search_term):
    """
    Поиск транзакций по комментарию
    """
    print("=" * 80)
    print(f"🔍 ПОИСК ТРАНЗАКЦИЙ ПО КОММЕНТАРИЮ: '{search_term}'")
    print("=" * 80)
    
    transactions = Transaction.objects.filter(
        comment__icontains=search_term
    ).select_related(
        'transaction_type',
        'linked_in_order',
        'linked_out_order'
    ).order_by('-creation_date')[:50]
    
    print(f"Найдено транзакций: {transactions.count()}")
    
    if transactions.exists():
        print("\nПоследние транзакции:")
        for tx in transactions:
            print(f"\n  ID: {tx.id}")
            print(f"  Дата: {tx.creation_date}")
            print(f"  Тип: {tx.transaction_type.name if tx.transaction_type else 'N/A'}")
            print(f"  Сумма: {tx.value} USDT")
            print(f"  Комментарий: {tx.comment[:80]}...")
            
            if tx.linked_in_order:
                print(f"  InOrder: {tx.linked_in_order.id}")
            elif tx.linked_out_order:
                print(f"  OutOrder: {tx.linked_out_order.id}")
    
    return transactions


