    def export_duplicates_to_csv(self, filename="transaction_duplicates.csv"):
        """
        Экспорт найденных дубликатов в CSV
        """
        if not self.results or not self.results['duplicate_groups']:
            print("Нет данных для экспорта!")
            return
        
        import csv
        
        with open(filename, 'w', newline='', encoding='utf-8') as csvfile:
            writer = csv.writer(csvfile)
            
            # Заголовок
            writer.writerow(["Отчет о дубликатах транзакций"])
            writer.writerow([f"Период: последние {self.days_back} дней"])
            writer.writerow([f"Дата отчета: {timezone.now().strftime('%Y-%m-%d %H:%M:%S')}"])
            writer.writerow([])
            
            writer.writerow(["Группа", "ID транзакции", "Дата", "Тип", "От", "Кому", "Сумма", "Описание"])
            
            group_num = 1
            for group in self.results['duplicate_groups']:
                for tx in group:
                    writer.writerow([
                        group_num,
                        tx.id,
                        tx.creation_date.strftime('%Y-%m-%d %H:%M:%S'),
                        tx.transaction_type.name if tx.transaction_type else "N/A",
                        tx.get_from(),
                        tx.get_to(),
                        f"{tx.value:.2f}",
                        tx.comment[:100]
                    ])
                group_num += 1
        
        print(f"\n📄 Отчет экспортирован в CSV файл: {filename}")


# Функции для удобного использования

def check_transaction_duplicates(days=30):
    """
    Основная функция проверки дубликатов транзакций
    """
    checker = TransactionDuplicateChecker(days)
    results = checker.find_duplicate_transactions()
    checker.print_summary_report()
    
    # Предлагаем экспорт
    export = input("\nЭкспортировать отчет в CSV? (yes/no): ").strip().lower()
    if export == 'yes':
        checker.export_duplicates_to_csv()
    
    return results


