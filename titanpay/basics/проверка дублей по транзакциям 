    def find_duplicates_for_order(self, order_id):
        """
        Поиск дубликатов транзакций для конкретного ордера
        """
        print("=" * 80)
        print(f"ПОИСК ДУБЛИКАТОВ ТРАНЗАКЦИЙ ДЛЯ ОРДЕРА {order_id}")
        print("=" * 80)
        
        # Ищем транзакции связанные с ордером
        in_order_transactions = Transaction.objects.filter(
            linked_in_order_id=order_id
        )
        
        out_order_transactions = Transaction.objects.filter(
            linked_out_order_id=order_id
        )
        
        all_transactions = list(in_order_transactions) + list(out_order_transactions)
        
        print(f"Найдено транзакций для ордера: {len(all_transactions)}")
        
        if not all_transactions:
            print("❌ Транзакции не найдены!")
            return []
        
        # Анализируем каждую транзакцию
        duplicate_groups = []
        
        for tx in all_transactions:
            print(f"\n🔍 Анализ транзакции {tx.id}:")
            self._print_transaction_details(tx)
            
            # Ищем дубликаты для этой транзакции
            duplicates = Transaction.objects.filter(
                from_balance=tx.from_balance,
                to_balance=tx.to_balance,
                transaction_type=tx.transaction_type,
                value=tx.value,
                creation_date__gte=tx.creation_date - timedelta(minutes=30),
                creation_date__lte=tx.creation_date + timedelta(minutes=30)
            ).exclude(id=tx.id).order_by('creation_date')
            
            if duplicates.exists():
                print(f"  ⚠️  Найдено {duplicates.count()} возможных дубликатов:")
                duplicate_group = [tx] + list(duplicates)
                duplicate_groups.append(duplicate_group)
                
                for dup in duplicates:
                    time_diff = abs((tx.creation_date - dup.creation_date).total_seconds())
                    print(f"    • ID: {dup.id} | Дата: {dup.creation_date} | Разница: {time_diff:.0f} сек")
            else:
                print("  ✅ Дубликатов не найдено")
        
        return duplicate_groups
    
