    def _find_exact_duplicates(self, transactions):
        """
        Поиск точных дубликатов (полное совпадение полей)
        """
        # Группируем по ключевым полям
        groups = defaultdict(list)
        
        for tx in transactions:
            # Создаем ключ для группировки
            key = (
                tx.from_balance_id,
                tx.to_balance_id,
                tx.transaction_type_id,
                tx.value,
                tx.comment[:100]  # Берем первые 100 символов комментария
            )
            groups[key].append(tx)
        
        # Возвращаем только группы с более чем одной транзакцией
        return [group for group in groups.values() if len(group) > 1]
    
    def _find_potential_duplicates(self, transactions):
        """
        Поиск потенциальных дубликатов (похожие транзакции)
        """
        # Группируем по упрощенному ключу
        groups = defaultdict(list)
        
        for tx in transactions:
            # Упрощенный ключ (без времени и ID)
            key = (
                tx.from_balance_id,
                tx.to_balance_id,
                tx.transaction_type_id,
                round(float(tx.value), 2)  # Округляем сумму
            )
            groups[key].append(tx)
        
        # Фильтруем группы и сортируем по времени
        result = []
        for key, tx_list in groups.items():
            if len(tx_list) > 1:
                # Сортируем по времени
                tx_list.sort(key=lambda x: x.creation_date)
                result.append(tx_list)
        
        # Сортируем группы по размеру (от большего к меньшему)
        result.sort(key=lambda x: len(x), reverse=True)
        
        return result
    
    def _analyze_by_transaction_type(self, transactions):
        """
        Анализ дубликатов по типам транзакций
        """
        analysis = {}
        
        # Получаем все типы транзакций
        tx_types = TransactionType.objects.all()
        
        for tx_type in tx_types:
            type_transactions = transactions.filter(transaction_type=tx_type)
            duplicate_groups = self._find_potential_duplicates(type_transactions)
            
            total_duplicates = sum(len(group) for group in duplicate_groups)
            
            analysis[tx_type.name] = {
                'count': type_transactions.count(),
                'total_amount': sum(tx.value for tx in type_transactions),
                'duplicate_count': total_duplicates,
                'duplicate_groups': len(duplicate_groups)
            }
        
        return analysis
    
    def _find_fast_sequential_transactions(self, transactions, max_seconds=10):
        """
        Поиск быстрых последовательных транзакций
        """
        fast_pairs = []
        
        # Сортируем по балансам и времени
        sorted_transactions = sorted(transactions, key=lambda x: (x.from_balance_id, x.to_balance_id, x.creation_date))
        
        for i in range(len(sorted_transactions) - 1):
            tx1 = sorted_transactions[i]
            tx2 = sorted_transactions[i + 1]
            
            # Проверяем, что транзакции между одинаковыми балансами
            if (tx1.from_balance_id == tx2.from_balance_id and 
                tx1.to_balance_id == tx2.to_balance_id):
                
                time_diff = (tx2.creation_date - tx1.creation_date).total_seconds()
                
                if time_diff <= max_seconds:
                    fast_pairs.append((tx1, tx2, time_diff))
        
        return fast_pairs
    
    def check_specific_transaction(self, transaction_id):
