                    time_diff = abs((tx.creation_date - similar_tx.creation_date).total_seconds())
                    print(f"  Разница во времени: {time_diff:.1f} секунд")
                    
                    # Проверяем, связаны ли с одним ордером
                    if tx.linked_in_order and similar_tx.linked_in_order:
                        if tx.linked_in_order == similar_tx.linked_in_order:
