class TraderCreateSerializer(serializers.ModelSerializer):
    user = serializers.PrimaryKeyRelatedField(queryset=User.objects.all(), validators=[UniqueValidator(queryset=SupportMember.objects.all()),
                                                               UniqueValidator(queryset=Trader.objects.all()),
                                                               UniqueValidator(queryset=Merchant.objects.all())])
    boss = serializers.PrimaryKeyRelatedField(queryset=Trader.objects.all(), required=False, allow_null=True)
    is_boss = serializers.BooleanField(required=True)
    team = serializers.PrimaryKeyRelatedField(queryset=TraderTeam.objects.all(), required=True)
    currency = serializers.PrimaryKeyRelatedField(queryset=Currency.objects.all(), required=True)
    address = serializers.CharField(write_only=True, required=False)

    class Meta:
        model = Trader
        fields = ('user', 'boss', 'is_boss', 'team', "currency", 'address')

    def validate(self, data):
        if data['is_boss'] is None and data['boss'] is None or data['is_boss'] is False and data['boss'] is None:
            raise serializers.ValidationError({"is_boss": "Should be true, as no senior trader is set"})

        if data['is_boss'] is True and data['boss'] is not None:
            raise serializers.ValidationError({"is_boss": "Should be false, as no senior trader is set"})

        return data

    def create(self, validated_data):
        balance = Balance.objects.create(type=0)
        frozen_balance = Balance.objects.create(type=1)
        address = generate_address()
        trader = Trader.objects.create(
            user=validated_data['user'],
            boss=validated_data['boss'],
            is_boss=validated_data['is_boss'],
            team=validated_data['team'],
            currency=validated_data['currency'],
            balance_usdt=balance,
            frozen_balance_usdt=frozen_balance
        )

        if trader.is_boss and address:
            Address.objects.create(address_public=address, balance=balance)
        return trader


class SupportMemberSerializer(serializers.ModelSerializer):
    username = serializers.SerializerMethodField()
    email = serializers.SerializerMethodField()
    first_name = serializers.SerializerMethodField()
    last_name = serializers.SerializerMethodField()

    class Meta:
        model = SupportMember
        fields = ('id', 'telegram', 'phone', 'is_head', 'language', 'controlled_teams', 'controlled_merchants', 'username', 'email', 'first_name', 'last_name')
        extra_kwargs = {"controlled_teams": {"required": False, "allow_null": True}, "controlled_merchants": {"required": False, "allow_null": True}}

    def get_username(self, obj):
        return obj.user.username

    def get_email(self, obj):
        return obj.user.email

    def get_first_name(self, obj):
        return obj.user.first_name

    def get_last_name(self, obj):
        return obj.user.last_name


