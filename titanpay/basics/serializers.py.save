class PaymentDetailsGroupShortSerializer(serializers.ModelSerializer):

    class Meta:
        model = PaymentDetailsGroup
        fields = ('id', 'status', 'trader', 'currency', 'payment_system', 'amount', 'in_active', 'out_active', 'current_volume', 'limit_per_period', 'total_volume', 'owner')

    def to_representation(self, instance):
        representation = super().to_representation(instance)

        representation['trader'] = instance.trader.user.username
        representation['currency'] = instance.currency.symbol
        representation['payment_system'] = instance.payment_system.name

        return representation


class PaymentDetailsGroupFullSerializer(serializers.ModelSerializer):

    class Meta:
        model = PaymentDetailsGroup
        fields = '__all__'

    def to_representation(self, instance):
        representation = super().to_representation(instance)
        details = PaymentDetails.objects.filter(group=instance, status=1)

        ps_name = instance.payment_system.name

        representation['trader'] = instance.trader.user.username
        representation['currency'] = instance.currency.symbol
        representation['payment_system'] = instance.payment_system.id
        representation['volume_in'] = instance.limit_per_period

        if ps_name in (SBER_NAME,C2C_NAME):
            representation['details'] = PaymentDetailsSberSerializer(details, many=True).data
        # else:
        #     representation['details'] = PaymentDetailsSerializer(balances, many=True).data
        return representation


class PaymentDetailsSerializer(serializers.ModelSerializer):
    class Meta:
        model = PaymentDetails
        fields = ['sberpay_enabled', 'sbp_enabled', 'card_number', 'phone', 'deposit_number']


class PaymentDetailsGroupCreateSerializer(serializers.ModelSerializer):
    details = PaymentDetailsSerializer(many=True, required=False)

    class Meta:
        model = PaymentDetailsGroup
        fields = ('owner', 'currency', 'payment_system', 'min_amount_out', 'max_amount_out', 'in_active', 'out_active', 'allowed_traffic', 'details', 'deposit_number_on', 'bic', 'work_type')

    def create(self, validated_data):
        traffic_types = validated_data.pop('allowed_traffic')
        if 'details' in validated_data.keys():
            details_data = validated_data.pop('details')
            payment_details_group = PaymentDetailsGroup.objects.create(**validated_data)
            for detail_data in details_data:
                try:
                    data = check_pd_data(detail_data)
                    details = PaymentDetails.objects.create(group=payment_details_group, **data)
                except IntegrityError as e:
                    raise ValidationError(detail=e.args[0])
        else:
            payment_details_group = PaymentDetailsGroup.objects.create(**validated_data)

        for traffic in traffic_types:
            payment_details_group.allowed_traffic.add(traffic)

        payment_details_group.save()

        return payment_details_group


