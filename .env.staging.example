# Staging environment — copy to .env.staging on server:
#   cp .env.staging.example .env.staging && nano .env.staging
# NEVER commit .env.staging to git

ACME_EMAIL=admin@avapay.net

# Separate DB from production
POSTGRES_DB=titanpay_db_staging
POSTGRES_USER=titanpay_staging
POSTGRES_PASSWORD=change-me-staging-password
CRYPTO_DB_NAME=cryptodb_staging

MAIN_DB_NAME=titanpay_db_staging
MAIN_DB_USER=titanpay_staging
MAIN_DB_PASSWORD=change-me-staging-password
MAIN_DB_HOST=staging-db
MAIN_DB_PORT=5432

DEBUG=True
SECRET_KEY=change-me-staging-secret-key-min-50-chars
LOCAL=False
DJANGO_SETTINGS_MODULE=titanpay.settings

REDIS_HOST=staging-redis:6379/1

# Staging subdomains (must match DNS + docker-compose.staging.yml)
VITE_API_URL=https://api-staging.avapay.net/api/v1
PUBLIC_API_URL=https://api-staging.avapay.net
PAYMENT_PAGE_URL=pay-staging.avapay.net

CRYPTO_URL=http://crypto:8082

# S3 — use a separate test bucket or leave empty if export works without S3
S3_ENDPOINT=https://storage.yandexcloud.net
ACCESS_KEY=
SECRET_S3_KEY=
BUCKET_NAME=

AUTOSMS_BUCKET_NAME=
AUTOSMS_S3_ENDPOINT=https://storage.yandexcloud.net
AUTOSMS_ACCESS_KEY=
AUTOSMS_SECRET_KEY=

# Provider keys — use sandbox/test credentials only, never production keys
PROTOCOL_API_BASE=https://prot0col.com
PROTOCOL_API_KEY=
PROTOCOL_MERCHANT_ID=
PROTOCOL_SECRET_KEY=
PROTOCOL_TRADER_USERNAME=protocol1_staging

PLAYMENTS_API_BASE=https://api.playments.world
PLAYMENTS_MERCHANT_GROUP_ID=
PLAYMENTS_MERCHANT_ID=
PLAYMENTS_SECRET_KEY=
PLAYMENTS_WEBHOOK_SECRET=
PLAYMENTS_DEFAULT_CLIENT_IP=127.0.0.1

CONCORDED_API_BASE=
CONCORDED_TRADER_USERNAME=concored_mmk_staging
CONCORDED_KBZPAY_TOKEN=
CONCORDED_WAVEPAY_TOKEN=
CONCORDED_PAYMENT_METHOD_MAP={"KBZPay":"","WavePay":""}
CONCORDED_AMOUNT_MINOR_FACTOR=1

# Bots are disabled in staging compose — leave tokens empty
TGBOT_TOKEN=
EMERGENCY_TELEBOT_TOKEN=
ORDERBOT_TELEBOT_TOKEN=
AUTOSMSBOT_TELEBOT_TOKEN=
API_BOT_KEY=
